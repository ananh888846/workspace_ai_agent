# Workspace AI Agent - development configuration
# Copy this file to .env for local development.
# Never commit the real .env or OAuth secrets.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql://workspace:workspace_dev_password@workspace-ai-agent-postgres:5432/workspace_ai_agent

QDRANT_URL=http://workspace-ai-agent-qdrant:6333
QDRANT_COLLECTION=knowledge_v1

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=/app/data/storage

GOOGLE_CREDENTIALS_FILE=/app/data/google/credentials.json
GOOGLE_TOKEN_DIR=/app/data/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

GOOGLE_CALENDAR_READ_SCOPE=https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CALENDAR_WRITE_SCOPE=https://www.googleapis.com/auth/calendar
