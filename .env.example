# Workspace AI Agent - development configuration
# Copy this file to .env for local development.
# Never commit the real .env or OAuth secrets.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Server-to-server authentication: Laravel Web -> Agent
# Production must use a long random secret and never commit the real value.
AGENT_SERVER_TOKEN=

POSTGRES_USER=workspace
POSTGRES_PASSWORD=workspace_dev_password
POSTGRES_DB=workspace_ai_agent
POSTGRES_HOST_PORT=5433

QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# Windows host -> Docker PostgreSQL :5433 -> container :5432
DATABASE_URL=postgresql://workspace:workspace_dev_password@127.0.0.1:5433/workspace_ai_agent

# Windows host -> Docker Qdrant :6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge_v1

# Ollama running directly on Windows host
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
KNOWLEDGE_RERANKER_ENABLED=true
KNOWLEDGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Multi-Hybrid LLM V1
# local = Ollama only; cloud = cloud provider only; hybrid = local first, cloud fallback
LLM_MODE=local
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_CHAT_MODEL=

FILE_STORAGE_DRIVER=local
# Windows direct runtime: use a local path, for example:
# FILE_STORAGE_PATH=./data/storage
FILE_STORAGE_PATH=./data/storage

GOOGLE_CREDENTIALS_FILE=./data/google/credentials.json
GOOGLE_TOKEN_DIR=./data/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

GOOGLE_CALENDAR_READ_SCOPE=https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CALENDAR_WRITE_SCOPE=https://www.googleapis.com/auth/calendar

# Google OAuth state và mã hóa credential
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_CREDENTIAL_ENCRYPTION_KEY=
